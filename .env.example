APP_ENV=development
PORT=8080
# Optional IP literal; leave empty to keep the default all-interface bind.
HTTP_LISTEN_HOST=
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=1048576
VITE_API_BASE_URL=/api

# Shared base64/base64url key (32+ decoded bytes) used to authenticate Cloudflare
# edge client-prefix context. Required in staging/production and must match the
# EDGE_CONTEXT_SECRET configured for the Pages Function.
EDGE_CONTEXT_SECRET=
EDGE_CONTEXT_MAX_SKEW=2m

# Dedicated base64/base64url key (32+ decoded bytes) for Calendar invitation
# recipient data at rest. There is no fallback to SESSION_SECRET: leave both
# values empty until the Calendar participation service is intentionally enabled.
# Keep the key only in the runtime secret store; the version is a non-secret
# positive PostgreSQL smallint rotation number, for example 1.
CALENDAR_PROTECTED_DATA_KEY=
CALENDAR_PROTECTED_DATA_KEY_VERSION=

# Deployment guardrail. Keep false until P5-COLLAB-17 exact staging acceptance.
# Tenant overrides cannot bypass this switch.
COLLABORATION_CONTROL_PLANE_ENABLED=false
# Browser-facing WebSocket origin of the dedicated whiteboard runtime. Configure
# this together with the shared runtime-to-control-plane token only when the
# grant broker is intentionally enabled. One-time browser grants expire in at
# most 60 seconds.
COLLABORATION_PROVIDER_URL=
COLLABORATION_GRANT_TTL=30s
# Emergency mode for the whiteboard control plane. Use read_only before off so
# authorized users can still inspect/export durable state during an incident.
COLLABORATION_RUNTIME_MODE=enabled

# Deployment guardrails. They can only disable features or lower tenant limits.
FEATURE_CONTROL_DISABLE_MEMBERSHIP_INVITATIONS=false
FEATURE_CONTROL_DISABLE_CLASS_MANAGEMENT=false
FEATURE_CONTROL_DISABLE_CLASS_INVITE_LINKS=false
FEATURE_CONTROL_DISABLE_CLASS_SESSION_SCHEDULING=false
FEATURE_CONTROL_DISABLE_AVAILABILITY_POLLS=false
FEATURE_CONTROL_DISABLE_CONVERSATIONS=false
# Keep fail-closed until P3-10 provides exact-version hash and scan authority.
FEATURE_CONTROL_DISABLE_FILE_UPLOADS=true
FEATURE_CONTROL_ENABLE_CLASS_SESSION_RECURRENCE=false
FEATURE_CONTROL_ENABLE_IN_APP_NOTIFICATIONS=false
FEATURE_CONTROL_ENABLE_CLASSROOM_MEDIA_ROOMS=false
FEATURE_CONTROL_ENABLE_INSTANT_STUDY_ROOMS=false
# Remains force-off through P5-COLLAB-17 exact staging acceptance.
FEATURE_CONTROL_ENABLE_CLASSROOM_WHITEBOARDS=false
FEATURE_CONTROL_MAX_MEMBERS=10000
FEATURE_CONTROL_MAX_ACTIVE_CLASSES=1000
FEATURE_CONTROL_MAX_INVITE_CREATIONS_PER_HOUR=10000
FEATURE_CONTROL_MAX_ACTIVE_AVAILABILITY_POLLS=200
FEATURE_CONTROL_MAX_AVAILABILITY_POLL_RANGE_DAYS=90
FEATURE_CONTROL_MAX_AVAILABILITY_POLL_SLOTS=1000
FEATURE_CONTROL_MAX_AVAILABILITY_POLL_PARTICIPANTS=500
FEATURE_CONTROL_MAX_AVAILABILITY_POLL_CREATIONS_PER_HOUR=200
FEATURE_CONTROL_MAX_AVAILABILITY_POLL_CAPABILITY_CREATIONS_PER_HOUR=1000
FEATURE_CONTROL_MAX_ACTIVE_STUDY_MEETINGS=200
FEATURE_CONTROL_MAX_MESSAGES_PER_TENANT=10000000
FEATURE_CONTROL_MAX_MESSAGE_SENDS_PER_HOUR=100000
FEATURE_CONTROL_MAX_FILES_PER_TENANT=1000000
FEATURE_CONTROL_MAX_FILE_BYTES_PER_TENANT=1099511627776
FEATURE_CONTROL_MAX_SINGLE_FILE_BYTES=5368709120
FEATURE_CONTROL_MAX_FILE_UPLOAD_INTENTS_PER_HOUR=100000
FEATURE_CONTROL_MAX_STUDY_MEETING_CREATIONS_PER_HOUR=200
FEATURE_CONTROL_MAX_ACTIVE_MEDIA_SPACES=100
FEATURE_CONTROL_MAX_MEDIA_PARTICIPANTS_PER_SPACE=50
FEATURE_CONTROL_MAX_ACTIVE_MEDIA_PARTICIPANTS=500
FEATURE_CONTROL_MAX_MEDIA_SPACE_STARTS_PER_HOUR=200
FEATURE_CONTROL_MAX_WHITEBOARD_DOCUMENTS_PER_TENANT=100
FEATURE_CONTROL_MAX_WHITEBOARD_CONNECTIONS_PER_TENANT=100
FEATURE_CONTROL_MAX_WHITEBOARD_STORAGE_BYTES_PER_TENANT=10737418240
FEATURE_CONTROL_MAX_WHITEBOARD_OPERATIONS_PER_MINUTE=60000

# Local-only credentials used by compose.yaml. Never reuse these values outside development.
# With Neon, replace DATABASE_POOL_URL with the pooled URL whose host contains -pooler.
DATABASE_POOL_URL=postgresql://tutorhub:tutorhub_local@localhost:5432/tutorhub?sslmode=disable
# Dedicated least-privilege URL for cmd/worker. In hosted environments this must
# use the worker role rather than the API or migration role.
DATABASE_WORKER_URL=postgresql://tutorhub_worker:tutorhub_worker_local@localhost:5432/tutorhub?sslmode=disable
# Direct URL for local migration jobs only. Never expose a production migration URL to the API.
DATABASE_MIGRATION_URL=postgresql://tutorhub:tutorhub_local@localhost:5432/tutorhub?sslmode=disable
# Direct URL for the operator-only Availability Poll retention job. This role
# receives schema USAGE and purge-function EXECUTE only; Core API never reads it.
DATABASE_POLL_MAINTENANCE_URL=postgresql://tutorhub_poll_maintenance:tutorhub_poll_maintenance_local@localhost:5432/tutorhub?sslmode=disable
REDIS_URL=redis://localhost:6379/0
DATABASE_MAX_CONNECTIONS=4
DATABASE_MIN_CONNECTIONS=0
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_QUERY_TIMEOUT=5s
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
OUTBOX_BATCH_SIZE=25
OUTBOX_CONCURRENCY=4
OUTBOX_POLL_INTERVAL=2s
OUTBOX_METRICS_INTERVAL=30s
OUTBOX_LEASE_DURATION=30s
OUTBOX_HANDLER_TIMEOUT=20s
OUTBOX_SHUTDOWN_TIMEOUT=30s
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=15m
OUTBOX_RETRY_JITTER_PERCENT=20
OUTBOX_ENABLE_IN_APP_NOTIFICATION_CANARY=false
SESSION_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback
OIDC_POST_LOGOUT_URL=http://localhost:5173/signed-out
OIDC_SCOPES=openid profile email
AUTH_FLOW_TTL=10m
SESSION_TTL=8h
SESSION_ABSOLUTE_TTL=24h
MEMBERSHIP_INVITATION_TTL=168h
SESSION_COOKIE_SECURE=false
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Dedicated whiteboard collaboration runtime. Deploy this service with an
# explicit environment allowlist; do not inject the whole Core API environment.
# DATABASE_COLLABORATION_URL must be the direct, TLS, least-privilege runtime
# role URL. It must never fall back to DATABASE_POOL_URL or a migration owner.
COLLAB_RUNTIME_PROFILE=FREE_PRIVATE_ALPHA
COLLAB_INSTANCE_COUNT=1
COLLAB_ALLOWED_ORIGINS=http://localhost:5173
COLLAB_CONTROL_PLANE_URL=http://localhost:8080
COLLAB_CONTROL_PLANE_TOKEN=
COLLAB_METRICS_TOKEN=
COLLAB_BUILD_ID=development
DATABASE_COLLABORATION_URL=
COLLAB_DRAIN_TIMEOUT_MS=45000
COLLAB_PROBE_TIMEOUT_MS=2000
COLLAB_MAX_AWARENESS_BYTES=16384
COLLAB_MAX_AWARENESS_DEPTH=8
COLLAB_MAX_AWARENESS_MESSAGES_PER_SECOND=30
COLLAB_MAX_AWARENESS_STATES=1
COLLAB_MAX_CONNECTIONS=100
COLLAB_MAX_CONNECTIONS_PER_ACTOR=3
COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=50
COLLAB_MAX_CONNECTIONS_PER_TENANT=100
COLLAB_MAX_DOCUMENT_BYTES=10485760
COLLAB_MAX_FRAME_BYTES=1048576
COLLAB_MAX_INGRESS_BYTES_PER_SECOND=4194304
COLLAB_MAX_MESSAGES_PER_SECOND=60
COLLAB_MAX_RECONNECT_ATTEMPTS=8
COLLAB_MAX_UPDATE_BYTES=786432

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=5m
